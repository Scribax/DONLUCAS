generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          String    @default("USER")
  points        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  weight      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model ShippingZone {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  coordinates String?  // Lo guardaremos como String (JSON.stringify) para SQLite
  color       String?  @default("#166534")
  orders      Order[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String?
  customerEmail String?
  customerPhone String?
  address       String?
  latitude      Float?
  longitude     Float?
  totalAmount   Float
  shippingCost  Float?
  distance      Float?
  paymentMethod String?
  status        String      @default("PENDING")
  shippingZoneId String?
  shippingZone  ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  pointsUsed    Int         @default(0)
  pointsEarned  Int         @default(0)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discount        Float
  type            String    @default("PERCENT")
  active          Boolean   @default(true)
  usedCount       Int       @default(0)
  usageLimit      Int?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  orders          Order[]
}
